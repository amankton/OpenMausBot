# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=chief-executive-suite
OMB_BIND_ADDRESS=127.0.0.1
OMB_HTTP_PORT=8089
# Leave empty to use http://localhost:${OMB_HTTP_PORT:-8089}.
OMB_PUBLIC_URL=
# Leave empty to inherit OMB_PUBLIC_URL.
OMB_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set OMB_PUBLIC_URL to https:// followed by the same hostname.
# Requires OMB_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
OMB_HTTPS_HOST=
OMB_LOCAL_IMAGE=chief-executive-suite-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
OMB_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
OMB_DATA_EXTERNAL=false

# Hermes: backend-to-server HTTP/SSE (never VITE_ variables).
HERMES_API_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_API_MODEL=hermes-agent
HERMES_API_TIMEOUT_MS=900000
# Explicit compatibility escape hatch for app-mounted MCP tools: http|acp.
HERMES_TRANSPORT=http

# Optional app tools/VM bridge; install integrations/hermes-http-tools first.
# HERMES_TOOL_BRIDGE_ENABLED=1
# HERMES_TOOL_BRIDGE_DIR=/absolute/path/to/hermes/chief-http-bridge
