+<!-- Chief meeting notes UI. Licensed under EPL-2.0. -->
+<script lang="ts">
+  import { onMount } from 'svelte'
+  import { showPopup } from '@hcengineering/ui'
+  import { captureController, liveCaptureStates } from '../capture-state'
+  import CapturePanel from './CapturePanel.svelte'
+  export let meetingId: string
+  const controller = captureController(meetingId)
+  onMount(() => {
+    void controller.refresh()
+    const timer = setInterval(() => { void controller.refresh() }, 2000)
+    return () => { clearInterval(timer) }
+  })
+  $: session = $controller.status?.session
+  $: visible = $controller.error !== undefined || (session !== undefined && liveCaptureStates.has(session.state))
+</script>
+{#if visible}
+  <aside aria-label="Meeting capture notice" class="capture-notice">
+    <span role="status">{$controller.error !== undefined ? 'Meeting capture status unavailable. Refresh to check.' : session?.state === 'pending' ? 'Meeting audio consent requested' : session?.state === 'capturing' ? 'Meeting audio capture active' : `Meeting notes: ${session?.state}`}</span>
+    <button type="button" on:click={() => showPopup(CapturePanel, { meetingId }, 'centered')}>Review consent / stop</button>
+  </aside>
+{/if}
+<style>
+  .capture-notice { position: fixed; right: 1rem; bottom: 4.5rem; z-index: 100; display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; max-width: calc(100vw - 2rem); padding: .65rem; border: 1px solid var(--theme-divider-color); border-radius: .5rem; color: var(--theme-content-color); background: var(--theme-panel-color); box-shadow: 0 2px 12px #0003; }
+  button { cursor: pointer; font: inherit; color: inherit; padding: .35rem; border: 1px solid var(--theme-divider-color); border-radius: .3rem; }
+  button:focus-visible { outline: 2px solid #2f58ff; }
+</style>
diff --git a/plugins/love-resources/src/components/CapturePanel.svelte b/plugins/love-resources/src/components/CapturePanel.svelte
new file mode 100644
index 0000000..1bc301f
--- /dev/null
+++ b/plugins/love-resources/src/components/CapturePanel.svelte
@@ -0,0 +1,162 @@
+<!-- Chief meeting notes UI. Licensed under EPL-2.0. -->
+<script lang="ts">
+  import { onDestroy, onMount } from 'svelte'
+  import { captureController, liveCaptureStates } from '../capture-state'
+  import { type CaptureSession } from '../capture-client'
+  import { reviewedBundle, type ReviewedItem } from '../capture-export'
+
+  export let meetingId: string
+  export let compact = false
+  const controller = captureController(meetingId)
+  let selected = ''
+  let reviewed: CaptureSession | undefined
+  let edits: ReviewedItem[] = []
+  let includeTranscript = false
+  let confirmed = false
+  let reviewError = ''
+  let loadingReview = false
+  let disposed = false
+  let reviewGeneration = 0
+  $: status = $controller.status
+  $: session = status?.session
+  $: own = session?.participants.find(person => person.personId === status?.selfPersonId)
+  $: active = session !== undefined && liveCaptureStates.has(session.state)
+  $: if (!$controller.fresh) { reviewed = undefined; confirmed = false; reviewGeneration++ }
+
+  const labels: Record<string, string> = {
+    pending: 'Waiting for everyone’s consent', starting: 'Starting local audio capture', capturing: 'Audio capture active',
+    stopping: 'Stopping capture', processing: 'Transcribing locally', ready: 'Transcript ready for review', failed: 'Capture failed',
+    cancelled: 'Capture cancelled', deleted: 'Capture deleted'
+  }
+  onMount(() => {
+    void controller.refresh()
+    const timer = setInterval(() => { void controller.refresh() }, 2000)
+    return () => { clearInterval(timer) }
+  })
+  onDestroy(() => { disposed = true; reviewGeneration++ })
+  async function loadReview (): Promise<void> {
+    const generation = ++reviewGeneration
+    reviewed = undefined; confirmed = false; includeTranscript = false; edits = []; reviewError = ''
+    if (selected === '') return
+    loadingReview = true
+    try {
+      const value = await controller.session(selected)
+      if (disposed || generation !== reviewGeneration) return
+      reviewed = value
+      edits = (value.suggestions ?? []).map(item => ({ id: item.id, text: item.text, selected: false }))
+    } catch (error) { reviewError = error instanceof Error ? error.message : 'Transcript unavailable.' }
+    finally { if (generation === reviewGeneration) loadingReview = false }
+  }
+  async function exportReview (): Promise<void> {
+    if (reviewed === undefined || status === undefined || !$controller.fresh) return
+    const generation = reviewGeneration
+    const sessionId = reviewed.id
+    reviewError = ''; loadingReview = true
+    try {
+      // Re-authorize at export time; no stale private transcript can bypass the server.
+      const latest = await controller.session(sessionId)
+      if (disposed || generation !== reviewGeneration || reviewed?.id !== sessionId || !$controller.fresh) return
+      if (JSON.stringify(latest) !== JSON.stringify(reviewed)) throw new Error('This session changed. Open it again and review the latest content.')
+      const json = reviewedBundle(latest, status.selfPersonId, edits, includeTranscript, confirmed)
+      const url = URL.createObjectURL(new Blob([json], { type: 'application/json;charset=utf-8' }))
+      const link = document.createElement('a')
+      link.href = url; link.download = 'chief-meeting-review.json'; link.click()
+      setTimeout(() => { URL.revokeObjectURL(url) }, 1000)
+    } catch (error) { reviewError = error instanceof Error ? error.message : 'Export failed.' }
+    finally { loadingReview = false }
+  }
+  async function removeReview (): Promise<void> {
+    if (reviewed === undefined || !window.confirm('Delete this meeting notes session and its private capture data?')) return
+    await controller.mutate('/session/' + encodeURIComponent(reviewed.id), undefined, 'DELETE')
+    selected = ''; reviewed = undefined; confirmed = false
+  }
+  async function retryReview (): Promise<void> {
+    if (reviewed === undefined || reviewed.state !== 'failed') return
+    await controller.mutate('/retry', { sessionId: reviewed.id, revision: reviewed.revision })
+    await loadReview()
+  }
+</script>
+
+<section class:compact class="capture-panel" aria-label="Quiet meeting notes">
+  <div class="heading"><strong>Quiet meeting notes</strong><button type="button" disabled={$controller.busy} on:click={() => controller.refresh()}>Refresh</button></div>
+  <p role="status" aria-live="polite">{!$controller.fresh ? ($controller.error ?? 'Checking availability…') : session !== undefined ? labels[session.state] : status?.available ? 'Ready to request consent' : 'Local capture unavailable'}</p>
+  {#if $controller.error}<p role="alert">{$controller.error}</p>{/if}
+  {#if status?.reason && !status.available}<p>{status.reason}</p>{/if}
+  {#if session?.reason}<p>{session.reason}</p>{/if}
+  {#if status !== undefined && $controller.fresh}
+    {#if !active}
+      <p>Audio only, transcribed on this computer. Everyone in the current meeting must agree, including the requester.</p>
+      <button type="button" disabled={!status.available || !status.joined || $controller.busy} on:click={() => controller.mutate('/request', { meetingId })}>Request everyone’s consent</button>
+      {#if !status.joined}<p>Join this meeting to request capture.</p>{/if}
+    {:else if session !== undefined}
+      <ul class="consents" aria-label="Individual consent">
+        {#each session.participants as person}<li>{person.name}{person.personId === status.selfPersonId ? ' (you)' : ''}: {person.consent}</li>{/each}
+      </ul>
+      {#if session.state === 'pending' && own?.consent === 'pending' && status.joined}
+        <p>Agree to record your published audio for local transcription and participant review. You can stop at any time.</p>
+        <div class="actions">
+          <button type="button" disabled={$controller.busy} on:click={() => controller.mutate('/consent', { sessionId: session.id, revision: session.revision, accept: true })}>I agree to audio capture</button>
+          <button type="button" disabled={$controller.busy} on:click={() => controller.mutate('/consent', { sessionId: session.id, revision: session.revision, accept: false })}>Decline</button>
+        </div>
+      {/if}
+      {#if own !== undefined && ['pending', 'starting', 'capturing'].includes(session.state)}
+        <button class="stop" type="button" disabled={$controller.busy} on:click={() => controller.mutate('/stop', { sessionId: session.id, revision: session.revision })}>Stop / withdraw consent</button>
+      {/if}
+      <p>Anyone joining, leaving or reconnecting stops this capture. A new request needs everyone’s fresh consent. Camera and microphone controls remain yours.</p>
+    {/if}
+  {/if}
+  <details open={!compact}>
+    <summary>History and review</summary>
+    <p>Only sessions the server authorizes for you appear here. Suggestions are drafts, never assignments.</p>
+    <label>Meeting notes session
+      <select aria-label="Meeting notes session" bind:value={selected} disabled={!$controller.fresh || loadingReview} on:change={loadReview}>
+        <option value="">Choose a session</option>
+        {#each $controller.history as item}<option value={item.id}>{new Date(item.requestedAt).toLocaleString()} — {labels[item.state]}</option>{/each}
+      </select>
+    </label>
+    {#if loadingReview}<p role="status">Loading…</p>{/if}
+    {#if reviewError}<p role="alert">{reviewError}</p>{/if}
+    {#if reviewed !== undefined && $controller.fresh}
+      <p>{labels[reviewed.state]} {reviewed.reason ?? ''}</p>
+      {#if reviewed.requestedBy === status?.selfPersonId}<button type="button" disabled={$controller.busy} on:click={removeReview}>Delete this session</button>{/if}
+      {#if reviewed.state === 'failed' && reviewed.requestedBy === status?.selfPersonId}
+        <button type="button" disabled={$controller.busy || !status?.available || Date.now() - reviewed.requestedAt >= 72 * 60 * 60 * 1000} on:click={retryReview}>Retry local transcription</button>
+        <p>Retries use retained audio only, when available within 72 hours. This does not start another capture.</p>
+      {/if}
+      {#if reviewed.state === 'ready'}
+        <details><summary>Read transcript ({reviewed.segments?.length ?? 0} segments)</summary>
+          {#each reviewed.segments ?? [] as utterance}<p><strong>{utterance.speaker}</strong> · {Math.floor(utterance.startMs / 1000)}s<br />{utterance.text}</p>{/each}
+        </details>
+        {#each edits as edit}
+          {@const suggestion = reviewed.suggestions?.find(item => item.id === edit.id)}
+          {@const source = reviewed.segments?.find(item => item.id === suggestion?.sourceSegmentId)}
+          <fieldset>
+            <legend>{suggestion?.kind === 'decision' ? 'Suggested decision' : 'Suggested action'}</legend>
+            <label><input type="checkbox" bind:checked={edit.selected} on:change={() => { confirmed = false }} /> Include this reviewed item</label>
+            <label>Reviewed text<textarea maxlength="4000" rows="3" bind:value={edit.text} on:input={() => { confirmed = false }} /></label>
+            {#if source}<blockquote><strong>{source.speaker}</strong> · {Math.floor(source.startMs / 1000)}s<br />{source.text}</blockquote>{/if}
+          </fieldset>
+        {/each}
+        <label><input type="checkbox" bind:checked={includeTranscript} on:change={() => { confirmed = false }} /> Include transcript in this export (off by default)</label>
+        <label><input type="checkbox" bind:checked={confirmed} /> I reviewed the selected material and want to export it to my personal Chief workspace.</label>
+        <button type="button" disabled={!confirmed || loadingReview || (!$controller.fresh)} on:click={exportReview}>Export reviewed JSON</button>
+        <p>This downloads a versioned file. Import and review it in personal Chief; nothing is sent to an agent automatically.</p>
+      {/if}
+    {/if}
+  </details>
+</section>
+
+<style>
+  .capture-panel { padding: 1rem; margin: .5rem 0; border: 1px solid var(--theme-divider-color); border-radius: .75rem; background: var(--theme-panel-color); color: var(--theme-content-color); max-width: 48rem; max-height: 80vh; overflow: auto; font-size: .875rem; }
+  .compact { padding: .75rem; }
+  .heading, .actions { display: flex; align-items: center; flex-wrap: wrap; justify-content: space-between; gap: .5rem; }
+  p, details, label, fieldset { margin-top: .75rem; }
+  label { display: block; }
+  button, select, textarea { font: inherit; color: inherit; background: var(--theme-panel-color); border: 1px solid var(--theme-divider-color); border-radius: .35rem; padding: .4rem .6rem; }
+  button { cursor: pointer; } button:disabled { opacity: .5; cursor: default; }
+  button:focus-visible, select:focus-visible, textarea:focus-visible, summary:focus-visible { outline: 2px solid #2f58ff; outline-offset: 2px; }
+  select, textarea { display: block; width: 100%; box-sizing: border-box; margin-top: .3rem; }
+  .stop { margin-top: .75rem; border-color: #b74a4a; }
+  .consents { padding-left: 1.25rem; }
+  blockquote { padding-left: .75rem; margin: .5rem 0; border-left: 2px solid var(--theme-divider-color); white-space: pre-wrap; }
+</style>
