--- /dev/null
+++ b/plugins/love-resources/src/capture-state.ts
@@ -0,0 +1,54 @@
+// Chief meeting notes UI. Licensed under EPL-2.0.
+import { writable } from 'svelte/store'
+import { getCurrentWorkspaceUuid } from '@hcengineering/presentation'
+import { CaptureClient, type CaptureSession, type CaptureStatus } from './capture-client'
+
+export const liveCaptureStates = new Set(['pending', 'starting', 'capturing', 'stopping', 'processing'])
+export interface CaptureView { status?: CaptureStatus, history: CaptureSession[], error?: string, busy: boolean, fresh: boolean }
+export function createCaptureController (client: Pick<CaptureClient, 'call'>, meetingId: string) {
+  let value: CaptureView = { history: [], busy: false, fresh: false }
+  const store = writable(value)
+  let pending: Promise<void> | undefined
+  let generation = 0
+  const set = (next: CaptureView): void => { value = next; store.set(next) }
+  async function refresh (): Promise<void> {
+    if (pending !== undefined) return await pending
+    const run = generation
+    pending = (async () => {
+      try {
+        const status = await client.call<CaptureStatus>('/status?meetingId=' + encodeURIComponent(meetingId))
+        const history = await client.call<{ sessions: CaptureSession[] }>('/history?meetingId=' + encodeURIComponent(meetingId))
+        if (run === generation) set({ status, history: history.sessions, fresh: true, busy: value.busy })
+      } catch (error) {
+        if (run === generation) set({ history: [], fresh: false, busy: false, error: error instanceof Error ? error.message : 'Meeting notes are unavailable.' })
+      } finally { pending = undefined }
+    })()
+    await pending
+  }
+  async function mutate (path: string, body?: unknown, method = 'POST'): Promise<void> {
+    if (value.busy || !value.fresh) return
+    set({ ...value, busy: true, error: undefined })
+    try { await client.call(path, method, body) } catch (error) {
+      set({ history: [], fresh: false, busy: false, error: error instanceof Error ? error.message : 'The request failed.' })
+      return
+    }
+    set({ ...value, busy: false })
+    await refresh()
+  }
+  return {
+    subscribe: store.subscribe, refresh, mutate,
+    session: async (id: string) => (await client.call<{ session: CaptureSession }>('/session/' + encodeURIComponent(id))).session,
+    clear: () => { generation++; set({ history: [], busy: false, fresh: false }) }
+  }
+}
+
+const controllers = new Map<string, ReturnType<typeof createCaptureController>>()
+export function captureController (meetingId: string): ReturnType<typeof createCaptureController> {
+  const workspace = getCurrentWorkspaceUuid()
+  const key = workspace + ':' + meetingId
+  // Clear private transcript/status views when the application switches workspace.
+  for (const [previous, controller] of controllers) if (!previous.startsWith(workspace + ':')) { controller.clear(); controllers.delete(previous) }
+  let controller = controllers.get(key)
+  if (controller === undefined) { controller = createCaptureController(new CaptureClient(workspace), meetingId); controllers.set(key, controller) }
+  return controller
+}
