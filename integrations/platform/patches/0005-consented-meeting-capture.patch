@@ -0,0 +1,58 @@
+// Chief meeting notes UI. Licensed under EPL-2.0, as the retained Platform source.
+import { concatLink } from '@hcengineering/core'
+import love from '@hcengineering/love'
+import { getMetadata } from '@hcengineering/platform'
+import { getCurrentWorkspaceUuid } from '@hcengineering/presentation'
+import { getPlatformToken } from './utils'
+
+export type CaptureState = 'pending' | 'starting' | 'capturing' | 'stopping' | 'processing' | 'ready' | 'failed' | 'cancelled' | 'deleted'
+export interface CaptureSegment { id: string, personId: string, speaker: string, startMs: number, endMs: number, text: string }
+export interface CaptureSuggestion { id: string, kind: 'decision' | 'action', text: string, sourceSegmentId: string, personId: string }
+export interface CaptureSession {
+  id: string
+  workspace: string
+  meetingId: string
+  title: string
+  revision: number
+  state: CaptureState
+  requestedBy: string
+  requestedAt: number
+  startedAt?: number
+  stoppedAt?: number
+  reason?: string
+  participants: Array<{ personId: string, name: string, consent: 'pending' | 'accepted' | 'declined' }>
+  segments?: CaptureSegment[]
+  suggestions?: CaptureSuggestion[]
+}
+export interface CaptureStatus {
+  available: boolean
+  reason?: string
+  worker: { state: 'offline' | 'ready' | 'busy' }
+  selfPersonId: string
+  joined: boolean
+  session?: CaptureSession
+  limits: { maxParticipants: number, maxDurationMs: number, maxBytes: number }
+}
+export class CaptureError extends Error {
+  constructor (readonly status: number) {
+    super(status === 409 ? 'Attendance or consent changed. Refresh and review the current request.' :
+      status === 401 || status === 403 ? 'Meeting notes are not available to this account.' :
+        status === 404 ? 'This meeting notes session is no longer available.' : 'Meeting notes are unavailable. Try refreshing.')
+  }
+}
+export class CaptureClient {
+  constructor (readonly workspace: string) {}
+  async call<T> (path: string, method = 'GET', body?: unknown): Promise<T> {
+    if (getCurrentWorkspaceUuid() !== this.workspace) throw new CaptureError(403)
+    const endpoint = getMetadata(love.metadata.ServiceEndpoint)
+    if (endpoint === undefined) throw new CaptureError(503)
+    const response = await fetch(concatLink(endpoint, '/capture' + path), {
+      method, credentials: 'omit', cache: 'no-store', signal: AbortSignal.timeout(15000),
+      headers: { Authorization: 'Bearer ' + getPlatformToken(), 'Content-Type': 'application/json' },
+      ...(body === undefined ? {} : { body: JSON.stringify(body) })
+    })
+    if (getCurrentWorkspaceUuid() !== this.workspace) throw new CaptureError(403)
+    if (!response.ok) throw new CaptureError(response.status)
+    return await response.json() as T
+  }
+}
diff --git a/plugins/love-resources/src/capture-export.ts b/plugins/love-resources/src/capture-export.ts
new file mode 100644
index 0000000..020a7c3
--- /dev/null
+++ b/plugins/love-resources/src/capture-export.ts
@@ -0,0 +1,38 @@
+// Chief meeting review format version 1. Licensed under EPL-2.0.
+import { type CaptureSession, type CaptureSegment } from './capture-client'
+
+export interface ReviewedItem { id: string, text: string, selected: boolean }
+function bounded (text: string, limit: number, label: string): string {
+  if (typeof text !== 'string' || text.trim().length === 0 || text.length > limit) throw new Error(label + ' is missing or too long.')
+  return text
+}
+function segment (value: CaptureSegment): CaptureSegment {
+  if (!Number.isFinite(value.startMs) || !Number.isFinite(value.endMs) || value.startMs < 0 || value.endMs < value.startMs) throw new Error('Invalid transcript timing.')
+  return { id: bounded(value.id, 200, 'Segment ID'), personId: bounded(value.personId, 200, 'Person ID'),
+    speaker: bounded(value.speaker, 200, 'Speaker'), startMs: value.startMs, endMs: value.endMs,
+    text: bounded(value.text, 8000, 'Source text') }
+}
+export function reviewedBundle (session: CaptureSession, reviewerPersonId: string, edits: ReviewedItem[], includeTranscript: boolean, confirmed: boolean, now = new Date()): string {
+  if (!confirmed || session.state !== 'ready' || !session.participants.some(p => p.personId === reviewerPersonId)) throw new Error('Review this authorized completed session before exporting.')
+  if (!Number.isSafeInteger(session.revision) || session.revision < 1 || !Number.isFinite(session.requestedAt) || session.requestedAt < 0) throw new Error('Invalid session provenance.')
+  const selected = edits.filter(item => item.selected)
+  if (selected.length > 100 || new Set(selected.map(item => item.id)).size !== selected.length) throw new Error('Select at most 100 distinct items.')
+  const segments = new Map((session.segments ?? []).map(value => [value.id, value]))
+  const suggestions = new Map((session.suggestions ?? []).map(value => [value.id, value]))
+  const items = selected.map(item => {
+    const suggestion = suggestions.get(item.id)
+    const original = suggestion === undefined ? undefined : segments.get(suggestion.sourceSegmentId)
+    if (suggestion === undefined || original === undefined || suggestion.personId !== original.personId || !['decision', 'action'].includes(suggestion.kind)) throw new Error('The source for a selected suggestion is no longer available.')
+    const { id, ...source } = segment(original)
+    return { id: bounded(suggestion.id, 200, 'Suggestion ID'), kind: suggestion.kind, text: bounded(item.text, 4000, 'Reviewed text'), source: { segmentId: id, ...source } }
+  })
+  if (includeTranscript && (session.segments?.length ?? 0) > 2000) throw new Error('The transcript exceeds the export limit of 2000 segments.')
+  if (items.length === 0 && !includeTranscript) throw new Error('Select reviewed items or explicitly include the reviewed transcript.')
+  const bundle = { format: 'chief.meeting-review', version: 1, exportedAt: now.toISOString(),
+    source: { workspace: bounded(session.workspace, 200, 'Workspace'), meetingId: bounded(session.meetingId, 200, 'Meeting'), sessionId: bounded(session.id, 200, 'Session'), revision: session.revision, title: bounded(session.title, 200, 'Meeting title'), requestedAt: session.requestedAt },
+    review: { confirmed: true, reviewerPersonId: bounded(reviewerPersonId, 200, 'Reviewer'), reviewedAt: now.toISOString() }, items,
+    ...(includeTranscript ? { transcript: [...segments.values()].map(segment) } : {}) }
+  const json = JSON.stringify(bundle, null, 2)
+  if (new TextEncoder().encode(json).byteLength > 512 * 1024) throw new Error('The reviewed export exceeds 512 KiB. Select fewer items or omit the transcript.')
+  return json
+}
diff --git a/plugins/love-resources/src/capture-state.ts b/plugins/love-resources/src/capture-state.ts
new file mode 100644
