diff --git a/services/love/src/admission.ts b/services/love/src/admission.ts
new file mode 100644
index 000000000..54ef64859
--- /dev/null
+++ b/services/love/src/admission.ts
@@ -0,0 +1,184 @@
+// Chief retained Platform admission increment. EPL-2.0; see upstream LICENSE.
+import { createHmac, timingSafeEqual } from 'node:crypto'
+import { type WorkspaceLoginInfo } from '@hcengineering/account-client'
+import { type RestClient } from '@hcengineering/api-client'
+import contact, { type Employee, type Person, type SocialIdentityRef } from '@hcengineering/contact'
+import { AccountRole, generateId, TxFactory, type Ref } from '@hcengineering/core'
+import love, { MeetingStatus, RoomAccess, type MeetingMinutes, type Office, type Room, type UserMeetingInvite } from '@hcengineering/love'
+
+export class AdmissionError extends Error {
+  constructor (readonly status: number, message: string) { super(message) }
+}
+interface Receipt {
+  purpose: 'chief-meeting-invite-v1'
+  state: 'pending' | 'accepted'
+  workspace: string
+  request: string
+  from: string
+  to: string
+  meeting?: string
+  room?: string
+  expires: number
+}
+export function signReceipt (receipt: Receipt, secret: string): string {
+  const body = Buffer.from(JSON.stringify(receipt)).toString('base64url')
+  return `${body}.${createHmac('sha256', secret).update(body).digest('base64url')}`
+}
+export function readReceipt (value: unknown, secret: string, now = Date.now()): Receipt | undefined {
+  if (typeof value !== 'string' || value.length > 4096) return
+  const [body, signature, extra] = value.split('.')
+  if (extra !== undefined || !body || !signature) return
+  const expected = createHmac('sha256', secret).update(body).digest()
+  const supplied = Buffer.from(signature, 'base64url')
+  if (supplied.length !== expected.length || !timingSafeEqual(supplied, expected)) return
+  try {
+    const receipt = JSON.parse(Buffer.from(body, 'base64url').toString()) as Receipt
+    if (receipt.purpose !== 'chief-meeting-invite-v1' || !Number.isFinite(receipt.expires) || receipt.expires <= now) return
+    return receipt
+  } catch { return undefined }
+}
+
+/** Uses existing Platform documents; no Chief identity, room or invitation store. */
+export class MeetingAdmission {
+  private static readonly responses = new Map<string, Promise<void>>()
+  constructor (
+    readonly auth: WorkspaceLoginInfo,
+    readonly caller: RestClient,
+    readonly system: RestClient,
+    readonly secret: string
+  ) {}
+
+  async actor (): Promise<Employee> {
+    if (this.auth.role === AccountRole.ReadOnlyGuest || this.auth.account == null || this.auth.workspace == null) {
+      throw new AdmissionError(403, 'A workspace member sign-in is required')
+    }
+    const person = await this.caller.findOne(contact.mixin.Employee, { personUuid: this.auth.account, active: true })
+    if (person == null) throw new AdmissionError(403, 'No active person belongs to this sign-in')
+    return person
+  }
+
+  async context (meetingId: Ref<MeetingMinutes>): Promise<{ meeting: MeetingMinutes, room: Room }> {
+    // Caller-scoped reads retain Platform space ACLs even though writes use the service identity.
+    const meeting = await this.caller.findOne(love.class.MeetingMinutes, { _id: meetingId })
+    if (meeting == null || ![MeetingStatus.Active, MeetingStatus.Pending].includes(meeting.status)) {
+      throw new AdmissionError(403, 'This meeting is not available')
+    }
+    const room = await this.caller.findOne(love.class.Room, { _id: meeting.attachedTo as Ref<Room> })
+    if (room == null || room.access === RoomAccess.DND || meeting.access === RoomAccess.DND) {
+      throw new AdmissionError(403, 'This room is not available')
+    }
+    return { meeting, room }
+  }
+
+  async authority (person: Ref<Person>, meeting: MeetingMinutes, room: Room): Promise<boolean> {
+    if ((room as Office).person != null) return (room as Office).person === person
+    const author = meeting.createdBy
+    if (author == null) return false
+    const identity = await this.system.findOne(contact.class.SocialIdentity, { _id: author as SocialIdentityRef })
+    return identity?.attachedTo === person
+  }
+
+  async requireJoin (meetingId: Ref<MeetingMinutes>): Promise<Employee> {
+    const person = await this.actor()
+    const { meeting, room } = await this.context(meetingId)
+    if ((room as Office).person === person._id) return person
+    if ((room as Office).person == null && await this.authority(person._id, meeting, room)) return person
+    if (room.access === RoomAccess.Open && meeting.access === RoomAccess.Open && (this.auth.role !== AccountRole.Guest || (room as Office).person == null)) return person
+    const invites = await this.system.findAll(love.class.UserMeetingInvite, { kind: 'invite-request', meeting: meetingId, status: 'accepted' })
+    const accepted = invites.some(invite => {
+      const proof = readReceipt(invite.admission, this.secret)
+      return proof?.state === 'accepted' && proof.workspace === this.auth.workspace && proof.request === invite._id &&
+        proof.meeting === meetingId && proof.room === room._id && proof.from === invite.from && proof.to === invite.to &&
+        (proof.from === person._id || proof.to === person._id)
+    })
+    if (!accepted) throw new AdmissionError(403, 'Accept a room invitation before joining')
+    return person
+  }
+
+  async invite (to: Ref<Person>, meetingId?: Ref<MeetingMinutes>): Promise<void> {
+    const person = await this.actor()
+    if (meetingId != null && typeof meetingId !== 'string') throw new AdmissionError(400, 'Invalid meeting')
+    if (typeof to !== 'string' || to === person._id) throw new AdmissionError(400, 'Choose another person')
+    const recipient = await this.caller.findOne(contact.mixin.Employee, { _id: to as Ref<Employee>, active: true })
+    const space = await this.system.findOne(contact.class.PersonSpace, { person: person._id })
+    if (recipient == null || space == null) throw new AdmissionError(403, 'Person is not available')
+    if (meetingId != null) {
+      const { meeting, room } = await this.context(meetingId)
+      // A knock goes to the room host. Other invitations require current admission.
+      if (!await this.authority(to, meeting, room)) await this.requireJoin(meetingId)
+    }
+    const id = generateId<UserMeetingInvite>()
+    const expiresAt = Date.now() + 30_000
+    const admission = signReceipt({ purpose: 'chief-meeting-invite-v1', state: 'pending', workspace: this.auth.workspace,
+      request: id, from: person._id, to, meeting: meetingId, expires: expiresAt }, this.secret)
+    const account = await this.caller.getAccount()
+    if (account.uuid !== this.auth.account || account.primarySocialId == null) {
+      throw new AdmissionError(403, 'The workspace identity could not be confirmed')
+    }
+    // Direct REST create is system-only. The member transaction path retains space ACLs.
+    const factory = new TxFactory(account.primarySocialId)
+    await this.caller.tx(factory.createTxCreateDoc(love.class.UserMeetingInvite, space._id, {
+      kind: 'invite-request', from: person._id, to, meeting: meetingId, status: 'pending', expiresAt, admission
+    }, id))
+  }
+
+  async respond (responseId: Ref<UserMeetingInvite>, accept: boolean, meetingId?: Ref<MeetingMinutes>): Promise<void> {
+    const initial = await this.caller.findOne(love.class.UserMeetingInvite, { _id: responseId })
+    const proof = readReceipt(initial?.admission, this.secret)
+    if (proof == null) throw new AdmissionError(403, 'Invitation is unavailable or expired')
+    const key = this.auth.workspace + ':' + proof.request
+    const previous = MeetingAdmission.responses.get(key) ?? Promise.resolve()
+    let release!: () => void
+    const done = new Promise<void>((resolve) => { release = resolve })
+    const queued = previous.then(async () => { await done })
+    MeetingAdmission.responses.set(key, queued)
+    await previous
+    try { await this.respondOnce(responseId, accept, meetingId) } finally {
+      release()
+      if (MeetingAdmission.responses.get(key) === queued) MeetingAdmission.responses.delete(key)
+    }
+  }
+
+  private async respondOnce (responseId: Ref<UserMeetingInvite>, accept: boolean, meetingId?: Ref<MeetingMinutes>): Promise<void> {
+    const person = await this.actor()
+    const response = await this.caller.findOne(love.class.UserMeetingInvite, { _id: responseId })
+    const pending = readReceipt(response?.admission, this.secret)
+    if (response?.kind !== 'invite-response' || response.to !== person._id || !['pending', 'accepted'].includes(response.status) ||
+        !['pending', 'accepted'].includes(pending?.state ?? '') || pending == null || pending.workspace !== this.auth.workspace || pending.from !== response.from || pending.to !== response.to) {
+      throw new AdmissionError(403, 'Invitation is unavailable or expired')
+    }
+    const request = await this.system.findOne(love.class.UserMeetingInvite, { _id: pending.request as Ref<UserMeetingInvite> })
+    const granted = readReceipt(request?.admission, this.secret)
+    if (request?.status === 'accepted' && granted?.state === 'accepted' && granted.workspace === this.auth.workspace &&
+        granted.request === request._id && granted.from === pending.from && granted.to === pending.to &&
+        typeof granted.meeting === 'string' && (meetingId == null || granted.meeting === meetingId)) {
+      if (!accept) throw new AdmissionError(409, 'Invitation was already accepted')
+      await this.context(granted.meeting as Ref<MeetingMinutes>)
+      await this.system.update(response, { status: 'accepted', meeting: granted.meeting as Ref<MeetingMinutes>, admission: request.admission })
+      return
+    }
+    if (pending.state !== 'pending' || request == null || request.kind !== 'invite-request' || request.status !== 'pending' || request.admission !== response.admission) {
+      throw new AdmissionError(403, 'Invitation was cancelled or already answered')
+    }
+    if (!accept) {
+      await this.system.update(request, { status: 'declined', admission: '' })
+      await this.system.update(response, { status: 'declined', admission: '' })
+      return
+    }
+    const target = pending.meeting ?? meetingId
+    if (typeof target !== 'string' || (pending.meeting != null && meetingId != null && pending.meeting !== meetingId)) {
+      throw new AdmissionError(400, 'Invitation does not match this meeting')
+    }
+    const { meeting, room } = await this.context(target as Ref<MeetingMinutes>)
+    const from = pending.from as Ref<Person>
+    if (!await this.authority(person._id, meeting, room) && !await this.authority(from, meeting, room) &&
+        (room.access !== RoomAccess.Open || meeting.access !== RoomAccess.Open)) {
+      throw new AdmissionError(403, 'Only the room host can approve a restricted-room invitation')
+    }
+    // A request without a meeting means a knock on the recipient's own office.
+    if (pending.meeting == null && (room as Office).person !== person._id) throw new AdmissionError(403, 'Choose your own office')
+    const admission = signReceipt({ ...pending, state: 'accepted', meeting: target, room: room._id, expires: Date.now() + 8 * 60 * 60 * 1000 }, this.secret)
+    await this.system.update(request, { status: 'accepted', meeting: target as Ref<MeetingMinutes>, admission })
+    await this.system.update(response, { status: 'accepted', meeting: target as Ref<MeetingMinutes>, admission })
+  }
+}
