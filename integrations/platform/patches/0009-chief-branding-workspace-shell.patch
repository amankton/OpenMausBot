+<script lang="ts">
+  import { onMount } from 'svelte'
+  let chiefSlot: HTMLDivElement
+  onMount(() => {
+    let hostOrigin: string | undefined
+    const report = (): void => {
+      if (hostOrigin === undefined || chiefSlot === undefined) return
+      const { x, y, width, height } = chiefSlot.getBoundingClientRect()
+      window.parent.postMessage({ type: 'chief:workspace:slot', rect: { x, y, width, height } }, hostOrigin)
+    }
+    const connect = (event: MessageEvent): void => {
+      if (window.parent === window || event.source !== window.parent || event.data?.type !== 'chief:workspace:hello') return
+      try {
+        const origin = new URL(event.origin)
+        if (origin.protocol !== 'http:' || !['localhost', '127.0.0.1'].includes(origin.hostname) || origin.hostname === window.location.hostname) return
+        hostOrigin = origin.origin
+        report()
+      } catch { /* Ignore invalid origins; this bridge only reports layout. */ }
+    }
+    window.addEventListener('message', connect)
+    if (window.parent !== window) window.parent.postMessage({ type: 'chief:workspace:ready' }, '*')
+    window.addEventListener('resize', report)
+    const observer = new ResizeObserver(report)
+    observer.observe(chiefSlot)
+    return () => {
+      observer.disconnect()
+      window.removeEventListener('message', connect)
+      window.removeEventListener('resize', report)
+    }
+  })
+
+</script>
+<div bind:this={chiefSlot} class="chief-brand-slot" aria-label="Chief Executive Suite">
+  <img src="/chief/avatar.svg" alt="" width="24" height="24" />
+  <span>Chief</span>
+</div>
+<style>
+  .chief-brand-slot {
+    display: flex;
+    flex: 0 0 112px;
+    width: 112px;
+    height: 32px;
+    align-items: center;
+    gap: 8px;
+    font-size: 14px;
+    font-weight: 600;
+  }
+
+</style>
