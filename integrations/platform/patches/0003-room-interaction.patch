@@ -0,0 +1,53 @@
+<!-- Chief retained Platform interaction increment. EPL-2.0; see upstream LICENSE. -->
+<script lang="ts">
+  import contact, { getCurrentEmployee, formatName, type Employee } from '@hcengineering/contact'
+  import { type Room } from '@hcengineering/love'
+  import { createQuery } from '@hcengineering/presentation'
+  import { closePopup } from '@hcengineering/ui'
+  import { placePersonInRoom } from '../room-invitation'
+
+  export let room: Room
+  let members: Employee[] = []
+  let selected = ''
+  let busy = false
+  let message = ''
+  const me = getCurrentEmployee()
+  createQuery().query(contact.mixin.Employee, { active: true }, (result) => {
+    members = result.filter((person) => person._id !== me && person.personUuid != null)
+  })
+  async function invite (): Promise<void> {
+    const person = members.find((member) => member._id === selected)
+    if (person == null || busy) return
+    busy = true
+    try {
+      await placePersonInRoom(person._id, room)
+      message = 'Invitation sent. They choose whether to accept; their camera and microphone stay off.'
+    } catch (error) {
+      message = error instanceof Error ? error.message : 'The invitation could not be sent. Try again.'
+    } finally { busy = false }
+  }
+</script>
+
+<section class="antiPopup chief-room-invite" aria-label="Invite a person to this room">
+  <h2>Invite a person</h2>
+  <label for="chief-room-person">Workspace member</label>
+  <select id="chief-room-person" bind:value={selected} disabled={busy}>
+    <option value="">Choose a person</option>
+    {#each members as person}<option value={person._id}>{formatName(person.name)}</option>{/each}
+  </select>
+  <p>The person receives an invitation. Accepting does not turn on their devices.</p>
+  <p role="status" aria-live="polite">{message}</p>
+  <div class="actions">
+    <button type="button" disabled={busy || selected === ''} on:click={() => { void invite() }}>{busy ? 'Sending…' : 'Send invitation'}</button>
+    <button type="button" on:click={() => closePopup()}>Close</button>
+  </div>
+</section>
+
+<style>
+  .chief-room-invite { width: 22rem; max-width: 90vw; padding: 1.25rem; gap: .75rem; display: flex; flex-direction: column; border-radius: .75rem; background: var(--popup-bg-color); color: var(--theme-content-color); box-shadow: var(--popup-shadow); }
+  h2 { font-size: 1rem; font-weight: 600; }
+  p { font-size: .8rem; line-height: 1.5; }
+  select, button { border: 1px solid var(--theme-divider-color); border-radius: .375rem; padding: .5rem; background: var(--popup-bg-color); color: inherit; }
+  .actions { display: flex; gap: .5rem; }
+  button:disabled { opacity: .5; }
+</style>
