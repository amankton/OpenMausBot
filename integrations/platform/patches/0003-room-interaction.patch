@@ -0,0 +1,49 @@
+// Chief retained Platform interaction increment. EPL-2.0; see upstream LICENSE.
+import contact, { getCurrentEmployee, type Employee, type Person } from '@hcengineering/contact'
+import { type Ref } from '@hcengineering/core'
+import love, { isOffice, MeetingStatus, RoomAccess, type Room } from '@hcengineering/love'
+import { getClient } from '@hcengineering/presentation'
+import { getCurrentLocation } from '@hcengineering/ui'
+import { sendInvites } from './invites'
+import { createMeeting, createMeetingDocument } from './meetings'
+
+export const personDragType = 'application/x-chief-office-person'
+
+export function readDraggedPerson (value: string, workspace: string): Ref<Person> | undefined {
+  if (value.length > 1024) return
+  try {
+    const data = JSON.parse(value)
+    if (data.workspace !== workspace || typeof data.person !== 'string' || !/^[a-zA-Z0-9:_-]{1,200}$/.test(data.person)) return
+    return data.person as Ref<Person>
+  } catch { return undefined }
+}
+
+/** UI intent only; Love independently validates identity, room access and acceptance. */
+export async function placePersonInRoom (person: Ref<Person>, room: Room): Promise<'joined' | 'invited'> {
+  const client = getClient()
+  const me = getCurrentEmployee()
+  if (room.access === RoomAccess.DND) throw new Error('This room is not accepting visitors.')
+  if (person === me) {
+    const meeting = await createMeeting(room)
+    if (meeting === undefined) throw new Error('An invitation was requested from the office owner. Wait for their acceptance.')
+    return 'joined'
+  }
+  const member = await client.findOne(contact.mixin.Employee, { _id: person as Ref<Employee>, active: true })
+  if (member == null || member.personUuid == null) throw new Error('Choose a signed-in workspace member.')
+  let meeting = await client.findOne(love.class.MeetingMinutes, {
+    attachedTo: room._id, status: { $in: [MeetingStatus.Active, MeetingStatus.Pending] }
+  })
+  if (meeting === undefined) {
+    if (isOffice(room) && room.person !== me) throw new Error('The office owner needs to start this meeting first.')
+    meeting = await createMeetingDocument(room)
+  }
+  await sendInvites([person], meeting._id)
+  return 'invited'
+}
+
+export function writeDraggedPerson (event: DragEvent, person: Ref<Person>): void {
+  event.stopPropagation()
+  if (event.dataTransfer == null) return
+  event.dataTransfer.effectAllowed = 'move'
+  event.dataTransfer.setData(personDragType, JSON.stringify({ person, workspace: getCurrentLocation().path[1] }))
+}
