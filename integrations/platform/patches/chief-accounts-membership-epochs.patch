+function getV2Migration3 (ns: string, flavor: DBFlavor): [string, string] {
+  const types = dbTypes[flavor]
+
+  // Generate flavor-specific SQL for adding the constraint.
+  const addConstraintSql =
+    flavor === 'postgres'
