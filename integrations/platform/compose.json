{
  "name": "chief-platform",
  "services": {
    "nginx": {
      "image": "nginx@sha256:644a70516a26004c97d0d85c7fe1d0c3a67ea8ab7ddf4aff193d9f301670cf36",
      "volumes": [
        "./nginx.conf:/etc/nginx/conf.d/default.conf:ro"
      ],
      "restart": "unless-stopped",
      "networks": [
        "backend"
      ],
      "pull_policy": "never",
      "ports": [
        "127.0.0.1:18087:80"
      ]
    },
    "cockroach": {
      "image": "cockroachdb/cockroach@sha256:885d9b0e3243f262976763717e547dbbe75ca999548f7a4ea95fcd30a9aee66c",
      "command": "start-single-node --accept-sql-without-tls",
      "environment": [
        "COCKROACH_DATABASE=chief_platform",
        "COCKROACH_USER=chief_platform",
        "COCKROACH_PASSWORD=${CHIEF_PLATFORM_DB_PASSWORD:?Run configure-chief-platform}"
      ],
      "volumes": [
        "cr_data:/cockroach/cockroach-data",
        "cr_certs:/cockroach/certs"
      ],
      "restart": "unless-stopped",
      "networks": [
        "backend"
      ],
      "pull_policy": "never"
    },
    "redpanda": {
      "image": "docker.redpanda.com/redpandadata/redpanda@sha256:04baa40ed34edf86028396f762be802f3b6b0acaab65e9de696a3f15d54c550f",
      "command": [
        "redpanda",
        "start",
        "--kafka-addr internal://0.0.0.0:9092,external://0.0.0.0:19092",
        "--advertise-kafka-addr internal://redpanda:9092,external://localhost:19092",
        "--pandaproxy-addr internal://0.0.0.0:8082,external://0.0.0.0:18082",
        "--advertise-pandaproxy-addr internal://redpanda:8082,external://localhost:18082",
        "--schema-registry-addr internal://0.0.0.0:8081,external://0.0.0.0:18081",
        "--rpc-addr redpanda:33145",
        "--advertise-rpc-addr redpanda:33145",
        "--mode dev-container",
        "--smp 1",
        "--default-log-level=info"
      ],
      "volumes": [
        "redpanda:/var/lib/redpanda/data"
      ],
      "environment": [
        "REDPANDA_SUPERUSER_USERNAME=chief_platform",
        "REDPANDA_SUPERUSER_PASSWORD=${CHIEF_PLATFORM_QUEUE_PASSWORD:?Run configure-chief-platform}"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "rpk",
          "cluster",
          "info"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 10
      },
      "networks": [
        "backend"
      ],
      "pull_policy": "never",
      "restart": "unless-stopped"
    },
    "minio": {
      "image": "pgsty/silo@sha256:635197cb9f36d01bee221d34d1c7d7960f6a95c48b0b6c01d99cd13bdae51a46",
      "command": "server /data --address \":9000\" --console-address \":9001\"",
      "volumes": [
        "files:/data"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "silo",
          "healthcheck",
          "ready"
        ],
        "interval": "5s",
        "retries": 10
      },
      "restart": "unless-stopped",
      "networks": [
        "backend"
      ],
      "pull_policy": "never",
      "environment": [
        "MINIO_ROOT_USER=${CHIEF_PLATFORM_STORAGE_USER:?Run configure-chief-platform}",
        "MINIO_ROOT_PASSWORD=${CHIEF_PLATFORM_STORAGE_PASSWORD:?Run configure-chief-platform}"
      ]
    },
    "elastic": {
      "image": "elasticsearch@sha256:f05ab7f4d2aa5040813a0ea4eb76fa99bb31459937a4539efe2f2c2dbb2109fb",
      "command": "/bin/sh -c \"./bin/elasticsearch-plugin list | grep -q ingest-attachment || yes | ./bin/elasticsearch-plugin install --silent ingest-attachment;\n/usr/local/bin/docker-entrypoint.sh eswrapper\"\n",
      "volumes": [
        "elastic:/usr/share/elasticsearch/data"
      ],
      "environment": [
        "ELASTICSEARCH_PORT_NUMBER=9200",
        "BITNAMI_DEBUG=true",
        "discovery.type=single-node",
        "ES_JAVA_OPTS=-Xms1024m -Xmx1024m",
        "http.cors.enabled=true",
        "http.cors.allow-origin=http://localhost:18087"
      ],
      "healthcheck": {
        "interval": "20s",
        "retries": 10,
        "test": "curl -s http://localhost:9200/_cluster/health | grep -vq '\"status\":\"red\"'"
      },
      "restart": "unless-stopped",
      "networks": [
        "backend"
      ],
      "pull_policy": "never"
    },
    "rekoni": {
      "image": "platformcollective/rekoni-service@sha256:13099c41001b368ec887f2c52efb4a5d6be767b43f007be988893c21c1a5451d",
      "environment": [
        "SECRET=${CHIEF_PLATFORM_SECRET:?Run configure-chief-platform}"
      ],
      "deploy": {
        "resources": {
          "limits": {
            "memory": "500M"
          }
        }
      },
      "restart": "unless-stopped",
      "networks": [
        "backend"
      ],
      "pull_policy": "never"
    },
    "print": {
      "image": "platformcollective/print@sha256:545e72ee2c896da1d264ef38d843488c04768cf807997cf3ffcc1f5e4ccc43c9",
      "environment": [
        "STORAGE_CONFIG=${CHIEF_PLATFORM_STORAGE:?Run configure-chief-platform}",
        "STATS_URL=http://stats:4900",
        "SECRET=${CHIEF_PLATFORM_SECRET:?Run configure-chief-platform}",
        "ACCOUNTS_URL=http://account:3000",
        "FRONT_URL=http://localhost:18087"
      ],
      "restart": "unless-stopped",
      "networks": [
        "backend"
      ],
      "pull_policy": "never"
    },
    "transactor": {
      "image": "platformcollective/transactor@sha256:87f6076880cf79cd28efdd74a04162a728be012e0931b6a30b8dfe6f7ec15173",
      "environment": [
        "SERVER_PORT=3333",
        "SERVER_SECRET=${CHIEF_PLATFORM_SECRET:?Run configure-chief-platform}",
        "DB_URL=${CHIEF_PLATFORM_DB_URL:?Run configure-chief-platform}",
        "STORAGE_CONFIG=${CHIEF_PLATFORM_STORAGE:?Run configure-chief-platform}",
        "FRONT_URL=http://localhost:18087",
        "ACCOUNTS_URL=http://account:3000",
        "FULLTEXT_URL=http://fulltext:4700",
        "STATS_URL=http://stats:4900",
        "LAST_NAME_FIRST=true",
        "QUEUE_CONFIG=redpanda:9092"
      ],
      "restart": "unless-stopped",
      "networks": [
        "backend"
      ],
      "pull_policy": "never",
      "depends_on": {
        "redpanda": {
          "condition": "service_healthy"
        }
      }
    },
    "collaborator": {
      "image": "platformcollective/collaborator@sha256:3c79023e3510d898b6ecaf4f63d1a4cea3a1e75bf6a67fd500cdaeaf902edb57",
      "environment": [
        "COLLABORATOR_PORT=3078",
        "SECRET=${CHIEF_PLATFORM_SECRET:?Run configure-chief-platform}",
        "ACCOUNTS_URL=http://account:3000",
        "STATS_URL=http://stats:4900",
        "STORAGE_CONFIG=${CHIEF_PLATFORM_STORAGE:?Run configure-chief-platform}"
      ],
      "restart": "unless-stopped",
      "networks": [
        "backend"
      ],
      "pull_policy": "never"
    },
    "account": {
      "image": "platformcollective/account@sha256:39715cb2edd146393ce3151ad90e6e62e3a30c7937038696670145281cc4f131",
      "environment": [
        "SERVER_PORT=3000",
        "SERVER_SECRET=${CHIEF_PLATFORM_SECRET:?Run configure-chief-platform}",
        "DB_URL=${CHIEF_PLATFORM_DB_URL:?Run configure-chief-platform}",
        "TRANSACTOR_URL=ws://transactor:3333;ws://localhost:18087/_transactor",
        "STORAGE_CONFIG=${CHIEF_PLATFORM_STORAGE:?Run configure-chief-platform}",
        "FRONT_URL=http://localhost:18087",
        "STATS_URL=http://stats:4900",
        "MODEL_ENABLED=*",
        "ACCOUNTS_URL=http://localhost:18087/_accounts",
        "ACCOUNT_PORT=3000",
        "QUEUE_CONFIG=redpanda:9092"
      ],
      "restart": "unless-stopped",
      "networks": [
        "backend"
      ],
      "pull_policy": "never",
      "depends_on": {
        "redpanda": {
          "condition": "service_healthy"
        }
      }
    },
    "workspace": {
      "image": "platformcollective/workspace@sha256:d3728e7a3eda3b0653627bcc7d82bb6308bc4debd665075af5fba270a3c12d88",
      "environment": [
        "SERVER_SECRET=${CHIEF_PLATFORM_SECRET:?Run configure-chief-platform}",
        "DB_URL=${CHIEF_PLATFORM_DB_URL:?Run configure-chief-platform}",
        "TRANSACTOR_URL=ws://transactor:3333;ws://localhost:18087/_transactor",
        "STORAGE_CONFIG=${CHIEF_PLATFORM_STORAGE:?Run configure-chief-platform}",
        "MODEL_ENABLED=*",
        "ACCOUNTS_URL=http://account:3000",
        "STATS_URL=http://stats:4900",
        "QUEUE_CONFIG=redpanda:9092",
        "ACCOUNTS_DB_URL=${CHIEF_PLATFORM_DB_URL:?Run configure-chief-platform}"
      ],
      "restart": "unless-stopped",
      "networks": [
        "backend"
      ],
      "pull_policy": "never",
      "depends_on": {
        "redpanda": {
          "condition": "service_healthy"
        }
      }
    },
    "front": {
      "image": "platformcollective/front@sha256:03c16b1ab7ab590f988d781cea345bb2ba06b7f792b819cdb0dd0b39bf14bebe",
      "environment": [
        "SERVER_PORT=8080",
        "SERVER_SECRET=${CHIEF_PLATFORM_SECRET:?Run configure-chief-platform}",
        "LOVE_ENDPOINT=http://localhost:18087/_love",
        "ACCOUNTS_URL=http://localhost:18087/_accounts",
        "ACCOUNTS_URL_INTERNAL=http://account:3000",
        "REKONI_URL=http://localhost:18087/_rekoni",
        "CALENDAR_URL=http://localhost:18087/_calendar",
        "GMAIL_URL=http://localhost:18087/_gmail",
        "TELEGRAM_URL=http://localhost:18087/_telegram",
        "STATS_URL=http://stats:4900",
        "STATS_API=http://localhost:18087/_stats",
        "UPLOAD_URL=/files",
        "ELASTIC_URL=http://elastic:9200",
        "COLLABORATOR_URL=ws://localhost:18087/_collaborator",
        "PRINT_URL=http://localhost:18087/_print",
        "STORAGE_CONFIG=${CHIEF_PLATFORM_STORAGE:?Run configure-chief-platform}",
        "TITLE=Chief Executive Suite — Platform",
        "DEFAULT_LANGUAGE=en",
        "LAST_NAME_FIRST=true",
        "DESKTOP_UPDATES_CHANNEL=chief-disabled",
        "DISABLED_FEATURES=auto-translate,mailboxes"
      ],
      "restart": "unless-stopped",
      "networks": [
        "backend"
      ],
      "pull_policy": "never"
    },
    "fulltext": {
      "image": "platformcollective/fulltext@sha256:5a442c2f4aeafca27a4fa975c63b02f0283252af08b4ca32ffe86dd0ce136d00",
      "environment": [
        "SERVER_SECRET=${CHIEF_PLATFORM_SECRET:?Run configure-chief-platform}",
        "DB_URL=${CHIEF_PLATFORM_DB_URL:?Run configure-chief-platform}",
        "FULLTEXT_DB_URL=http://elastic:9200",
        "ELASTIC_INDEX_NAME=huly_storage_index",
        "STORAGE_CONFIG=${CHIEF_PLATFORM_STORAGE:?Run configure-chief-platform}",
        "REKONI_URL=http://rekoni:4004",
        "ACCOUNTS_URL=http://account:3000",
        "STATS_URL=http://stats:4900",
        "QUEUE_CONFIG=redpanda:9092"
      ],
      "restart": "unless-stopped",
      "networks": [
        "backend"
      ],
      "pull_policy": "never",
      "depends_on": {
        "redpanda": {
          "condition": "service_healthy"
        }
      }
    },
    "stats": {
      "image": "platformcollective/stats@sha256:940dae1aeaebc41b3a9123cab68c630bf1e6b21bbf520ba29921bf72f4aa27c3",
      "environment": [
        "PORT=4900",
        "SERVER_SECRET=${CHIEF_PLATFORM_SECRET:?Run configure-chief-platform}"
      ],
      "restart": "unless-stopped",
      "networks": [
        "backend"
      ],
      "pull_policy": "never"
    },
    "kvs": {
      "image": "platformcollective/hulykvs@sha256:765ca15bb643e4f8d42dba9bc0bf0d0e668ee5ced8fb1c432abb142946b09d4f",
      "depends_on": {
        "cockroach": {
          "condition": "service_started"
        }
      },
      "environment": [
        "HULY_DB_CONNECTION=${CHIEF_PLATFORM_DB_URL:?Run configure-chief-platform}",
        "HULY_TOKEN_SECRET=${CHIEF_PLATFORM_SECRET:?Run configure-chief-platform}"
      ],
      "restart": "unless-stopped",
      "networks": [
        "backend"
      ],
      "pull_policy": "never"
    }
  },
  "volumes": {
    "cr_data": {
      "name": "chief-platform_cr_data"
    },
    "cr_certs": {
      "name": "chief-platform_cr_certs"
    },
    "redpanda": {
      "name": "chief-platform_redpanda"
    },
    "files": {
      "name": "chief-platform_files"
    },
    "elastic": {
      "name": "chief-platform_elastic"
    }
  },
  "networks": {
    "backend": {
      "name": "chief-platform_backend"
    }
  }
}
